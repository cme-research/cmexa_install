# Copy to .env and run setup.sh to fill system-specific values.
# LAUNCH_FILE selects the nav mode without restarting the hardware container.

LAUNCH_FILE=cmexaiii_nav_mapping.launch.py
INPUT_GID=

# Robot identity. ROBOT selects the ROS launch/description (ROBOT env) and the
# container names (<ROBOT>-hardware / <ROBOT>-nav). ROBOT_INSTANCE is the MQTT
# id: the cmeresearch/<instance>/... topic prefix + mosquitto bridge routing.
# Defaults target the production mecanum robot. For the diff-drive mini set:
#   ROBOT=cmexamini
#   ROBOT_INSTANCE=cmexamini-001
#   LAUNCH_FILE=cmexamini_nav_mapping.launch.py
# (or pass --robot/--instance to deploy.sh, which writes these back here).
ROBOT=cmexaiii
ROBOT_INSTANCE=cmexaiii-001

# Image versions — use a semver tag (e.g. 1.2.3) to pin a release,
# or leave as "latest" to always pull the newest jazzy build.
ROBOT_VERSION=latest
WEBAPP_VERSION=latest
